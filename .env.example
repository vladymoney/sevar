# Docker / production settings — copy to .env and fill in.
# Host port of the container (unusual on purpose, so it does not clash with other projects on the VPS)
WEB_PORT=24917
# 0.0.0.0 = reachable at http://<VPS-IP>:WEB_PORT. Set 127.0.0.1 once the domain goes through the host nginx + HTTPS.
BIND_ADDR=0.0.0.0
# Password for /admin (required)
ADMIN_PASSWORD=
# Long random string used to sign admin sessions
SESSION_SECRET=
# Claude API key for the website chat (leave empty to disable the chat)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5-5
# SMTP for sending label requests by e-mail (e.g. a Gmail/Yahoo app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Recipient of label requests, orders and inquiries (default d.alishahov@yahoo.com)
LABELS_MAIL_TO=d.alishahov@yahoo.com
# Optional: separate mailboxes (fall back to LABELS_MAIL_TO)
ORDERS_MAIL_TO=
NOTIFY_MAIL_TO=
# Optional, printed on PDF offers
COMPANY_EIK=
COMPANY_VAT=
