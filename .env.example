# Docker / production settings — copy to .env and fill in.
# Host port of the container (unusual on purpose, so it does not clash with other projects on the VPS)
WEB_PORT=24917
# 0.0.0.0 = reachable at http://<VPS-IP>:WEB_PORT. Set 127.0.0.1 once the domain goes through the host nginx + HTTPS.
BIND_ADDR=0.0.0.0
# Public address used in canonical links, social previews and sitemap.xml (default https://sevarbg.com)
SITE_URL=https://sevarbg.com
# Temporary lock for the whole public site: while set, visitors see a "coming soon" page and need this password.
# Delete the line (or leave it empty) and run "docker compose up -d" to open the site. /admin is never locked.
SITE_PASSWORD=
# Password for /admin (required)
ADMIN_PASSWORD=
# Long random string used to sign admin sessions
SESSION_SECRET=
# Claude API key for the website chat (leave empty to disable the chat)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5-5
# --- E-mail (SMTP) ---------------------------------------------------------------------------------
# Without these the site still works and saves everything in /admin, but sends no e-mails.
# Best: the info@sevarbg.com mailbox at SuperHosting — cPanel → Email Accounts → info@ → "Connect Devices"
# shows the outgoing (SMTP) server. Port 465 = SSL, 587 = STARTTLS. Check it in /admin → Имейли → "Изпрати тест".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender address (normally the same mailbox as SMTP_USER)
MAIL_FROM=
# Where customers' replies go (default: the e-mail in js/data/company.js, info@sevarbg.com)
MAIL_REPLY_TO=
# Who receives what (each one falls back to the next, so one address is enough):
#   NOTIFY_MAIL_TO  — new inquiries from the forms and the AI chat
#   ORDERS_MAIL_TO  — new shop orders and B2B requests
#   LABELS_MAIL_TO  — label requests (with PDF); default d.alishahov@yahoo.com
NOTIFY_MAIL_TO=
ORDERS_MAIL_TO=
LABELS_MAIL_TO=d.alishahov@yahoo.com
# Optional, printed on PDF offers
COMPANY_EIK=
COMPANY_VAT=
